# Build artifacts
.output/
dist/
node_modules/
.wxt/

# Generated dictionary artifacts (injected at build time by wxt.config.ts; regenerate with `bun run dict:encrypt`)
data/dictionary.enc.json

# Sensitive category backup (kept locally only, not published)
tools/dictionary.grey-area.json

# Sync staging artifacts (regenerated by the dict:sync* scripts)
tools/*.staged.json

