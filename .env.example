# 本地配置模板：复制成 .env 填写即可。
#
# Bun 会自动加载 .env / .env.local（无需 dotenv 依赖），
# 但**已经导出的环境变量优先**，不会被文件里的值覆盖（`export TYPESAFE_API_KEY=...` 更强势）。
# .env 已在 .gitignore 里，不会入库。

# ============ TypeSafe System One (Jev) ============
# 只有 `--ai-review` 需要。取 key：https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# 自托管 DiffusionGemma 走同一套 API；本地端点（localhost/127.0.0.1）免鉴权，可不填 key
# TYPESAFE_BASE_URL=http://127.0.0.1:8096
# TYPESAFE_MODEL=jev-latest

# 剔除阈值（默认 0.7）：每个变体问一个 Noul 问题——「变体里是否含有通用交易词缀」，
# 概率 >= 阈值即剔除。调低 = 剔得更多（0.5 误杀约 31 条 / 0.7 约 3 条，实测）。
# AI_NOISE_THRESHOLD=0.7
